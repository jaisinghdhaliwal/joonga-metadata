<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><EnableWindowsTargeting>true</EnableWindowsTargeting>
  <AssemblyName>Joonga Metadata</AssemblyName><Product>Joonga Metadata</Product><RootNamespace>MetadataTransfer.Windows</RootNamespace><ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
  <ApplicationManifest>app.manifest</ApplicationManifest><NoWarn>$(NoWarn);WPF0001</NoWarn>
  <Version>0.9.1</Version>
  <FileVersion>0.9.1.0</FileVersion>
  <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
 </PropertyGroup>
 <ItemGroup><ProjectReference Include="../MetadataTransfer.Core/MetadataTransfer.Core.csproj"/><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35"/></ItemGroup>
 <ItemGroup><Resource Include="Assets/AppIcon.ico"/></ItemGroup>
 <ItemGroup><Content Include="Assets/Map/**/*" CopyToOutputDirectory="PreserveNewest"/></ItemGroup>
 <ItemGroup><Content Include="../MetadataTransfer.Tests/Fixtures/*" Link="SmokeFixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/></ItemGroup>
 <ItemGroup><Content Include="ThirdPartyLicenses/*" CopyToOutputDirectory="PreserveNewest"/></ItemGroup>
</Project>
